# Copy this file to ".env" (same folder) and fill in at least one key.
# With no key at all the app still runs in demo mode: live data works,
# but it can't answer general questions.

# ---- Language model ---------------------------------------------------
# auto = use every key you've set, Gemini first, falling back to the next
#        when one is rate limited. Other values: gemini, groq, openai_compat, demo
LLM_PROVIDER=auto

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional. minimal | low | medium | high. Lower means the reply starts sooner, which matters most
# for voice. Try "minimal" or "low" once everything works.
GEMINI_THINKING_LEVEL=

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional. low | medium | high. Lower is faster; "low" suits voice.
GROQ_REASONING_EFFORT=

# Upper limit on each reply, counting the model's hidden reasoning. If Groq reports a
# tokens-per-minute limit, lower this; if answers get cut off, raise it.
LLM_MAX_OUTPUT_TOKENS=4096

# Optional: any other OpenAI-compatible server (OpenRouter, Ollama, LM Studio).
# Example for Ollama: http://localhost:11434/v1 with model llama3.2
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---- Data sources -----------------------------------------------------
# All of them work with these left as they are.
# Optional GitHub token (no scopes needed): raises the limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
# Optional personal NASA key from https://api.nasa.gov (the shared DEMO_KEY allows 30/hour).
NASA_API_KEY=DEMO_KEY
# Optional Tavily key (free tier at https://tavily.com) for better web search.
# Without it Aura falls back to DuckDuckGo and Wikipedia.
TAVILY_API_KEY=
# Optional: your email, added to the User-Agent header as Wikipedia requests.
CONTACT_EMAIL=
# true = answer from bundled sample data instead of the real APIs (works offline).
OFFLINE_SAMPLE_DATA=false

# ---- Storage and security ---------------------------------------------
# Local default is a SQLite file. In the cloud, paste your Postgres URL here.
DATABASE_URL=sqlite:///./aura.db
# Sites allowed to call this API from a browser, comma separated.
# After deploying the frontend, add its URL, e.g. https://aura-yourname.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chat requests allowed per browser per minute.
RATE_LIMIT_PER_MINUTE=20
